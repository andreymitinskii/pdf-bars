[Desktop Entry]
Type=Application
Name=Создание ярлыка pdf bars
Comment=Однократное создание ярлыка pdf bars на рабочем столе
Exec=/usr/libexec/pdf-bars-create-desktop-shortcut
TryExec=/usr/libexec/pdf-bars-create-desktop-shortcut
Terminal=false
NoDisplay=true
X-GNOME-Autostart-enabled=true
X-MATE-Autostart-enabled=true
StartupNotify=false
